# ==============================================================================
# CARIÑOSAS.TOP — ENVIRONMENT CONFIGURATION (OBSIDIAN ELITE)
# ==============================================================================
# Copia este archivo a `.env.local` para desarrollo, y añade las MISMAS
# variables en Vercel → Settings → Environment Variables para producción.
# ⚠️ NUNCA pegues las claves en un chat ni las subas a un repositorio público.
# ==============================================================================

# ─────────────────────────── OBLIGATORIAS ───────────────────────────
# Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Supabase Server-Only Secret Key (Bypasses RLS for Admin Actions).
# 🔒 Supabase → Settings → API → Regenerate. NUNCA en un repo público.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Administración (invéntalas, fuertes). El código falla en frío si faltan.
ADMIN_SECRET=your-32-character-random-admin-secret-key-here
ADMIN_PASSKEY=Choose-A-Strong-Passkey

# Configuración pública del sitio
NEXT_PUBLIC_SITE_URL=https://carinosas.top
NEXT_PUBLIC_WHATSAPP_CONCIERGE=593987654321

# UploadThing (fotos/audio/video — verificación 4K y reels)
UPLOADTHING_SECRET=sk_live_...
UPLOADTHING_APP_ID=...

# ─────────────────────────── RECOMENDADAS ───────────────────────────
# Cloudflare Turnstile (protección antibot). Cloudflare → Turnstile → Create site.
# OJO: el widget (TurnstileWidget.tsx) lee la SITE key con prefijo NEXT_PUBLIC_
CLOUDFLARE_TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Gemini AI (concierge avanzado). aistudio.google.com → Get API key.
GEMINI_API_KEY=

# Bot de Telegram (avisos en vivo). @BotFather → /newbot; y TELEGRAM_CHAT_ID de tu canal/grupo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional: URL de render.com si usás render como backend (para el keep-alive).
RENDER_URL=

# ─────────────────────────── OPCIONALES ───────────────────────────
# Solo si usás Cloudflare Image Resizing / Workers.
NEXT_PUBLIC_CLOUDFLARE_IMAGES_ZONE=https://carinosas.top

# Nota: el código ahora es "fail-closed" — si faltan SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_URL o ADMIN_SECRET/ADMIN_PASSKEY, el sitio no arranca. Correcto por seguridad.

# ─────────────────────────── NOWPAYMENTS (Pago VIP Crypto Automático) ───────────────────────────
# Checkout automático de pases VIP con crypto (USDT). Crear cuenta en nowpayments.io:
#   - API Key:   membership → API keys (Dashboard → Settings → Payments)
#     ⚠️ NUNCA la expongas en el frontend: el servidor la usa para crear órdenes (POST /v1/payment)
#     y para consultar estado (GET /v1/payment/{id}). Endpoints: /api/np/create-payment y /api/np/status.
#   - IPN Secret: Dashboard → Settings → Payments → "IPN secret key".
#     Verifica las notificaciones al webhook /api/webhooks/vip-pass (HMAC SHA-512, header x-nowpayments-sig).
#   - En el webhook debe configurarse la URL HTTPS de producción (ipn_callback_url).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Opcional: precios por tier en USD (JSON). Por defecto:
#   {"Plata": 29, "Oro": 39, "Diamante": 49, "Alpha Founder": 75}
# El monto SIEMPRE lo fija el servidor (el cliente no decide precios).
VP_TIER_PRICES=

# Opcional (fallback manual, flujo tradicional de copia/pega de hash):
# Wallets a mostrar en "USDT Manual" del modal de checkout. Requieren prefijo
# NEXT_PUBLIC_ para estar disponibles en el navegador. Si quedan vacías, el tab
# manual muestra un aviso y se recomienda usar el flujo automático.
NEXT_PUBLIC_VIP_TRC20_WALLET=
NEXT_PUBLIC_VIP_BEP20_WALLET=
