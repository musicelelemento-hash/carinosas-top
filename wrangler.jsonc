{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carinosas-top",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "placement": {
    "mode": "smart"
  },
  // Rate limiting compartido entre instancias (login admin, anti-spam del chat).
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "79824ff3a7d64a0d9bc8e6ba109050b8"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://carinosas.top",
    "NODE_ENV": "production"
  }
}
