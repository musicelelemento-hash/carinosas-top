{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carinosas-top",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://carinosas.top",
    "NODE_ENV": "production"
  }
}
